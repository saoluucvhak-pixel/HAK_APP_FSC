{
  "name": "hakqn-ho-so-khai-thac",
  "productName": "HAKQN - Hồ sơ khai thác và vận chuyển gỗ keo",
  "version": "1.4.35",
  "description": "Phần mềm desktop quản lý hồ sơ khai thác và vận chuyển gỗ keo theo từng rừng (HAK Group)",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "build:html": "node scripts/build-html.js",
    "start": "electron .",
    "test": "node scripts/test.js",
    "test:e2e": "node scripts/e2e-all.js",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "fixtures": "node tests/fixtures/make-lookup.js",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "jszip": "^3.10.2",
    "playwright-core": "^1.65.0"
  },
  "author": "HAK Group",
  "build": {
    "appId": "vn.hakgroup.hakqn.hosokhaithac",
    "productName": "HAKQN - Ho so khai thac va van chuyen go keo",
    "copyright": "HAK Group",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "renderer/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "HAKQN - Hồ sơ khai thác",
      "language": "1066",
      "deleteAppDataOnUninstall": false,
      "artifactName": "HAKQN-HoSoKhaiThac-Setup-${version}.exe"
    },
    "npmRebuild": false
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "^11.0.8"
    },
    "@electron/universal": {
      "minimatch": "^11.0.8"
    }
  }
}
